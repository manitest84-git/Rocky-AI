# ─── Tailscale Local Machine IP ───
# Your local machine running Ollama, LiveKit, and Piper TTS (connected via Tailscale)
LOCAL_MACHINE_IP=100.125.118.104

# Unified Gateway Configuration
GATEWAY_PORT=3000

# LiveKit Configuration (runs on local machine via Tailscale)
LIVEKIT_URL=ws://100.125.118.104:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Ollama Configuration (runs on local machine via Tailscale)
OLLAMA_BASE_URL=http://100.125.118.104:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Piper TTS Configuration (runs on local machine via Tailscale)
PIPER_TTS_URL=http://100.125.118.104:5000

# Client / Frontend Configuration (Unified through Port 3000 Gateway)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend Internal Configuration
BACKEND_PORT=8333

# Security & Remote Access (Comma-separated allowed client IPs & Web Origins)
# Set ALLOWED_HOSTS to specific remote IPs like "192.168.1.50,10.0.0.12" or "*" to allow all
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*
