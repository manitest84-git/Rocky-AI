# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# ==============================================================================
# Android & Gradle Build Artifacts
# ==============================================================================

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files & directories
bin/
gen/
out/
release/

# Gradle files & caches
.gradle/
.gradle-home/
gradle-home/
build/
*/build/
gradle-app.setting
*.zip
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (SDK path, NDK path, etc.)
local.properties

# Log files
*.log

# Proguard / R8 folder generated by Eclipse or Gradle
proguard/

# Android Studio captures folder
captures/

# Android Studio Navigation editor temp files
.navigation/

# Android Profiling
*.hprof

# ==============================================================================
# Security & Signing (Keystores & Secrets)
# ==============================================================================
*.jks
*.keystore
*.bks
*.p12
*.key
signing.properties
release-signing.properties
secrets.properties

# Google Services (Firebase / Google APIs)
# Uncomment if your project contains sensitive API keys in google-services.json
# google-services.json

# ==============================================================================
# IDE & System Files
# ==============================================================================

# Android Studio / IntelliJ IDEA
*.iml
.idea/
!.idea/codeStyles/
!.idea/copyright/
!.idea/inspectionProfiles/
!.idea/compiler.xml
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml

# Eclipse
.project
.classpath
.settings/

# VS Code
.vscode/

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db

# ==============================================================================
# Native / C++ Builds (NDK / CMake)
# ==============================================================================
.externalNativeBuild/
.cxx/
ndk-build/

# ==============================================================================
# Fastlane & Tooling
# ==============================================================================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/readme.md

# Lint outputs
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint/reports/

# ==============================================================================
# Capacitor Specific (Generated Assets & Plugins)
# ==============================================================================
# Cordova plugins for Capacitor
capacitor-cordova-android-plugins/

# Copied web assets (copied during `cap copy` / `cap sync`)
app/src/main/assets/public/

# Generated Capacitor configuration files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml

